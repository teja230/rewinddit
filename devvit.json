{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "rewinddittt",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Rewinddit Post",
        "description": "Create a new Rewinddit daily quiz post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "rewinddit-daily-seed": {
        "cron": "0 0 * * *",
        "endpoint": "/internal/scheduler/rewinddit-daily-seed"
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT"]
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "rewinddittt_dev"
  }
}
